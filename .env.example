# ── Server ──────────────────────────────────────────────────────────
PORT=4005

# ── Azure AD / Entra ID ──────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ── Data tier ────────────────────────────────────────────────────────
# "transcripts" (standard M365), "insights" (Copilot), or "both"
GRAPH_DATA_TIER=transcripts

# ── Sync schedule ────────────────────────────────────────────────────
SYNC_CRON="0 * * * *"
SYNC_LOOKBACK_DAYS=30

# ── Elasticsearch client ─────────────────────────────────────────────
# Retry/timeout budget per request; the values below are the defaults. Lower
# them if you would rather a failing call give up quickly than retry with
# backoff. Both must be non-negative integers — the app refuses to start
# otherwise, because a non-numeric value makes the client resolve requests
# without performing them.
# ES_MAX_RETRIES=5
# ES_REQUEST_TIMEOUT_MS=30000

# ── Session ──────────────────────────────────────────────────────────
# Random string used to sign session cookies — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# ── Elasticsearch ────────────────────────────────────────────────────
# Password for the Elasticsearch `elastic` user. The web app uses it to
# authenticate to Elasticsearch, which is not exposed on the host network.
# Auto-generated (and backfilled) by the install/start/update scripts.
# Generate manually with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ES_SECRET=
